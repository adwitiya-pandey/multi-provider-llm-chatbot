# Multi-Provider LLM Chatbot Environment Configuration Example
# Copy this file to .env and insert your real Gemini API key for live mode:
# cp .env.example .env

# Google Gemini API Key (only key needed for live mode)
# Leave blank or set LLM_MODE=scripted for zero-key offline demo mode
GEMINI_API_KEY=your-gemini-key-here

# Optional: Anthropic & OpenAI API keys (not required; adapters are fully tested offline)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Execution mode: "auto" (default: "live" if GEMINI_API_KEY is present, else "scripted"), "live", or "scripted"
LLM_MODE=auto

# Hard session spending cap in USD (default: $0.50)
SESSION_BUDGET_USD=0.50

# Maximum sliding window turns and token budget
MAX_HISTORY_TURNS=10
MAX_HISTORY_TOKENS=6000
